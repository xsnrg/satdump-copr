Fix static-initialization-order fiasco causing satdump to segfault at load.

satdump::RESPATH / satdump::LIBPATH were defined in satdump_vars.cpp and built
via init_res_path()/init_lib_path(), which copy the globals RESOURCES_PATH /
LIBRARIES_PATH defined in a different TU (generated satdump_varst.cpp). There is
no guaranteed dynamic-init order across TUs, so RESPATH could be constructed while
RESOURCES_PATH was still zero-initialized (null dataptr). GCC 16 libstdc++ (fc44+)
dereferences that null even for a 0-length copy, segfaulting in _dl_init before
main. Define RESPATH/LIBPATH in the same TU, right after RESOURCES_PATH.
---

diff -ruN a/src-core/satdump_vars.cpp b/src-core/satdump_vars.cpp
--- a/src-core/satdump_vars.cpp	2026-09-27 14:58:28.508889403 -0500
+++ b/src-core/satdump_vars.cpp	2026-09-27 14:58:28.545843632 -0500
@@ -74,8 +74,8 @@
     std::string init_res_path() { return std::string(RESOURCES_PATH); }
     std::string init_lib_path() { return std::string(LIBRARIES_PATH); }
 #endif
-    std::string RESPATH = init_res_path();
-    std::string LIBPATH = init_lib_path();
+    // RESPATH/LIBPATH moved to satdump_varst.cxx to fix static init order (RESPATH must
+    // be constructed after RESOURCES_PATH, which lives in the same TU there).
 
     std::string getSatDumpVersionName() { return "SatDump v" + (std::string)SATDUMP_VERSION + (satdump::SATDUMP_VERSION_TAG.size() ? " (" + satdump::SATDUMP_VERSION_TAG + ")" : ""); }
 } // namespace satdump
\ No newline at end of file
diff -ruN a/src-core/satdump_varst.cxx b/src-core/satdump_varst.cxx
--- a/src-core/satdump_varst.cxx	2026-09-27 14:58:28.510889425 -0500
+++ b/src-core/satdump_varst.cxx	2026-09-27 14:58:28.545895022 -0500
@@ -5,6 +5,12 @@
 {
     SATDUMP_DLL const std::string RESOURCES_PATH = "@RESOURCES_PATH@";
     SATDUMP_DLL const std::string LIBRARIES_PATH = "@LIBRARIES_PATH@";
+    std::string init_res_path();
+    std::string init_lib_path();
+
+    std::string RESPATH = init_res_path();
+    std::string LIBPATH = init_lib_path();
+
     SATDUMP_DLL const std::string SATDUMP_VERSION = "@SATDUMP_VERSION@";
     SATDUMP_DLL const std::string SATDUMP_VERSION_TAG = "@SATDUMP_VERSION_TAG@";
 } // namespace satdump
\ No newline at end of file
